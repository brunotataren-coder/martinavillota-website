# Wallet mode
WALLET_PROVIDER=cdp

# CDP config (required in cdp mode)
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
CDP_WALLET_SECRET=your_wallet_secret

# Network and token
CDP_NETWORK=base
CDP_TOKEN=usdc
CDP_TOKEN_DECIMALS=6
CDP_ACCOUNT_PREFIX=whatsapp-pay-demo

# Optional: force token contract address matching
# CDP_TOKEN_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Safety switch
PAYMENTS_ENABLED=true

# App settings
PORT=8787
REQUEST_TTL_SECONDS=120
DEFAULT_CUSTOMER_BALANCE=80
MOCK_FEE_RATE=0.01

# Optional: map WhatsApp sender numbers to actor roles
# Format examples: +56912345678
WA_CUSTOMER_PHONE=
WA_MERCHANT_PHONE=

# HubSpot CRM (read-only clone)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com
HUBSPOT_TIMEOUT_SECONDS=20
HUBSPOT_CACHE_TTL_SECONDS=120

# Twilio WhatsApp (production sender + outbound API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+15557418797
